# DeepSeek API Key (Required for AI curation)
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
DEEPSEEK_MODEL="deepseek-chat"

# Discord Webhook (Required for Discord delivery)
# Create in Discord: Channel Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Notion Integration (Optional - only if using Notion delivery)
NOTION_TOKEN="secret_your_notion_integration_token"
NOTION_DATABASE_ID="your_32_character_database_id"

# Curation Thresholds
MIN_RELEVANCE_SCORE=7
MAX_ARTICLES=10
